{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/upload/blob/route.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "env": {
    "NEXT_PUBLIC_MAX_FILE_SIZE": "104857600",
    "DB_URI": "mongodb+srv://conculato5_db_user:quanha9948@cluster0.salxuo0.mongodb.net/exe_project?retryWrites=true&w=majority",
    "MONGODB_URI": "mongodb+srv://conculato5_db_user:quanha9948@cluster0.salxuo0.mongodb.net/exe_project?retryWrites=true&w=majority",
    "JWT_SECRET": "your-super-secret-jwt-key-here"
  }
}
